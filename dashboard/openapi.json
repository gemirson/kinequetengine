{
  "openapi": "3.0.3",
  "info": {
    "title": "kce-api",
    "description": "Axum HTTP API layer for the KineContext Engine",
    "license": {
      "name": ""
    },
    "version": "6.0.0"
  },
  "paths": {
    "/action": {
      "post": {
        "tags": [
          "crate"
        ],
        "summary": "POST /action handler (FT-006).",
        "description": "Executes an mRNA instruction with TTL enforcement.",
        "operationId": "action_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Execute mRNA instruction"
          }
        }
      }
    },
    "/ais/probe": {
      "post": {
        "tags": [
          "crate"
        ],
        "summary": "AIS probe handler.",
        "operationId": "ais_probe_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AisProbeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "AIS probe result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AisProbeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation or dimension error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/encode": {
      "post": {
        "tags": [
          "crate"
        ],
        "summary": "POST /encode handler (FT-006).",
        "description": "Encodes ECMA nodes into an mRNA instruction using MCE.",
        "operationId": "encode_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EncodeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Encode ECMA nodes into mRNA instruction"
          }
        }
      }
    },
    "/events": {
      "get": {
        "tags": [
          "crate"
        ],
        "summary": "Server-sent events stream of [`EngineEvent`]s.",
        "description": "Send `data: {\"type\":\"...\", ...}` frames; keep-alive every 15s.",
        "operationId": "events_handler",
        "responses": {
          "200": {
            "description": "SSE event stream"
          }
        }
      }
    },
    "/graph": {
      "get": {
        "tags": [
          "crate"
        ],
        "summary": "Full semantic graph: nodes, edges, pheromone levels.",
        "operationId": "graph_handler",
        "responses": {
          "200": {
            "description": "Graph topology and pheromone levels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "crate"
        ],
        "summary": "GET /health handler (FT-012: smart healthcheck).",
        "description": "Actually checks WAL and DB status rather than returning hardcoded values.",
        "operationId": "health_handler",
        "responses": {
          "200": {
            "description": "Engine health report"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "crate"
        ],
        "summary": "GET /metrics handler (FT-007: real metrics in Prometheus format).",
        "operationId": "metrics_handler",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/nodes": {
      "post": {
        "tags": [
          "crate"
        ],
        "summary": "Create a node (optionally connected to an existing one).",
        "operationId": "create_node_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Node created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateNodeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Connect target not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/nodes/{id}": {
      "delete": {
        "tags": [
          "crate"
        ],
        "summary": "Remove a node from the graph.",
        "operationId": "delete_node_handler",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Node ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Node deleted"
          },
          "404": {
            "description": "Node not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/nodes/{id}/state": {
      "post": {
        "tags": [
          "crate"
        ],
        "summary": "Set a node's lifecycle state.",
        "operationId": "set_node_state_handler",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Node ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetNodeStateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "State updated"
          },
          "404": {
            "description": "Node not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/pheromone/deposit": {
      "post": {
        "tags": [
          "crate"
        ],
        "summary": "Deposit pheromone on an edge.",
        "operationId": "deposit_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepositRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Pheromone deposited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepositResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/query": {
      "post": {
        "tags": [
          "crate"
        ],
        "summary": "POST /query handler.",
        "description": "Features:\n- Backpressure via semaphore (max 100 concurrent).\n- Timeout enforcement via `tokio::time::timeout`.\n- Pipeline execution in `spawn_blocking` to avoid blocking the async runtime.\n- Real metrics update on success / failure.",
        "operationId": "query_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Execute query against engine pipeline",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponseBody"
                }
              }
            }
          },
          "400": {
            "description": "Validation or tenant error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or backpressure exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ActionBody": {
        "type": "object",
        "description": "Request body for POST /action (FT-006).",
        "required": [
          "mrna",
          "created_at_ms"
        ],
        "properties": {
          "created_at_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "mrna": {
            "type": "object"
          }
        }
      },
      "AisProbeRequest": {
        "type": "object",
        "description": "Request body for `POST /ais/probe`.",
        "required": [
          "vector"
        ],
        "properties": {
          "vector": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "description": "Vector to evaluate (expected 128 dimensions)."
          }
        }
      },
      "AisProbeResponse": {
        "type": "object",
        "description": "Response of `POST /ais/probe`.",
        "required": [
          "is_anomaly",
          "score",
          "threshold"
        ],
        "properties": {
          "is_anomaly": {
            "type": "boolean",
            "description": "Whether an anomaly was detected."
          },
          "score": {
            "type": "number",
            "format": "double",
            "description": "Normalized anomaly score in 0..=1."
          },
          "threshold": {
            "type": "number",
            "format": "double",
            "description": "Anomaly threshold."
          }
        }
      },
      "CreateNodeRequest": {
        "type": "object",
        "description": "Request body for `POST /nodes`.",
        "properties": {
          "connect_to": {
            "type": "integer",
            "format": "int64",
            "description": "Optional existing node to connect to after creation.",
            "nullable": true,
            "minimum": 0
          },
          "weight": {
            "type": "number",
            "format": "double",
            "description": "Edge weight in 0..=1 (defaults to 0.5) when `connect_to` is set.",
            "nullable": true
          }
        }
      },
      "CreateNodeResponse": {
        "type": "object",
        "description": "Response of `POST /nodes`.",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "New node id (>= 10_000).",
            "minimum": 0
          }
        }
      },
      "DepositRequest": {
        "type": "object",
        "description": "Request body for `POST /pheromone/deposit`.",
        "required": [
          "from",
          "to",
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Deposit amount (must be finite and > 0)."
          },
          "from": {
            "type": "integer",
            "format": "int64",
            "description": "Source node id.",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "format": "int64",
            "description": "Target node id.",
            "minimum": 0
          }
        }
      },
      "DepositResponse": {
        "type": "object",
        "description": "Response of `POST /pheromone/deposit`.",
        "required": [
          "level"
        ],
        "properties": {
          "level": {
            "type": "number",
            "format": "double",
            "description": "Resulting pheromone level."
          }
        }
      },
      "EncodeBody": {
        "type": "object",
        "description": "Request body for POST /encode (FT-006).",
        "required": [
          "nodes",
          "intent"
        ],
        "properties": {
          "intent": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Uniform error body used by non-Json-pipeline handlers.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Machine-readable code."
          },
          "message": {
            "type": "string",
            "description": "Human-readable message."
          }
        }
      },
      "GraphEdgeDto": {
        "type": "object",
        "description": "A graph edge as exposed by `GET /graph`.",
        "required": [
          "from",
          "to",
          "weight"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "format": "int64",
            "description": "Source node id.",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "format": "int64",
            "description": "Target node id.",
            "minimum": 0
          },
          "weight": {
            "type": "number",
            "format": "double",
            "description": "Edge weight in 0..=1."
          }
        }
      },
      "GraphNodeDto": {
        "type": "object",
        "description": "A graph node as exposed by `GET /graph`.",
        "required": [
          "id",
          "state",
          "usage_count",
          "entropy",
          "connections",
          "maturity"
        ],
        "properties": {
          "connections": {
            "type": "integer",
            "format": "int64",
            "description": "Number of graph connections.",
            "minimum": 0
          },
          "entropy": {
            "type": "number",
            "format": "double",
            "description": "Entropy in 0..=1."
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Node id.",
            "minimum": 0
          },
          "maturity": {
            "type": "number",
            "format": "double",
            "description": "Maturity in 0..=1."
          },
          "state": {
            "type": "string",
            "description": "ECMA lifecycle state.",
            "example": "Stem"
          },
          "usage_count": {
            "type": "integer",
            "format": "int64",
            "description": "Usage counter.",
            "minimum": 0
          }
        }
      },
      "GraphResponse": {
        "type": "object",
        "description": "Response of `GET /graph`.",
        "required": [
          "nodes",
          "edges",
          "pheromone"
        ],
        "properties": {
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphEdgeDto"
            },
            "description": "Unique undirected edges."
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphNodeDto"
            },
            "description": "Registered ECMA nodes."
          },
          "pheromone": {
            "type": "object",
            "description": "Pheromone levels keyed by `\"<from>_<to>\"`.",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            }
          }
        }
      },
      "QueryBody": {
        "type": "object",
        "description": "Request body for POST /query.",
        "required": [
          "query_vector",
          "top_k"
        ],
        "properties": {
          "query_vector": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          },
          "top_k": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "QueryResponseBody": {
        "type": "object",
        "description": "Response body for POST /query.",
        "required": [
          "action",
          "result",
          "pipeline_ms",
          "stages"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "pipeline_ms": {
            "type": "number",
            "format": "double"
          },
          "result": {},
          "stages": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            }
          }
        }
      },
      "SetNodeStateRequest": {
        "type": "object",
        "description": "Request body for `POST /nodes/:id/state`.",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "type": "string",
            "description": "Target lifecycle state (e.g. `Stem`, `Apoptosis`).",
            "example": "Apoptosis"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "kce",
      "description": "KineContext Engine API"
    }
  ]
}