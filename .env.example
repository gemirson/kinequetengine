# KineQuetEngine Configuration
KCE_PORT=8080
KCE_HOST=0.0.0.0
KCE_LOG_LEVEL=info
KCE_TIMEOUT_MS=100
KCE_TENANT_RATE_LIMIT=50
KCE_MAX_CONCURRENT=100

# Feature flags
KCE_ENABLE_ACO=true
KCE_ENABLE_AIS=true
KCE_ENABLE_OT=true
KCE_ENABLE_GRAPH=true

# Retrieval
KCE_RETRIEVAL_TOP_K=10
KCE_RETRIEVAL_THRESHOLD=0.7

# Cache
KCE_CACHE_L1_CAPACITY=2048
KCE_CACHE_L1_TTL_SECS=300
KCE_CACHE_L3_CAPACITY=512
KCE_CACHE_L3_TTL_SECS=600

# Latency budget (ms)
KCE_BUDGET_TOTAL_MS=10
KCE_BUDGET_PARSE_MS=0.5
KCE_BUDGET_RETRIEVAL_MS=3.0
KCE_BUDGET_RANKING_MS=2.0
KCE_BUDGET_EXECUTION_MS=1.0

# AIS
KCE_AIS_DETECTION_THRESHOLD=0.7
KCE_AIS_EXPIRY_DAYS=90

# Storage
KCE_STORAGE_PATH=./data/kce
